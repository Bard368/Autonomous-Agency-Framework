    {
      "parameters": {
        "jsCode": "let data = {};\n\n// Проверяем, кто именно запустил воркфлоу\nif ($('Webhook').isExecuted) {\n    // Если запустили через вебхук\n    data = $('Webhook').first().json.body || {};\n} else if ($('When Executed by Another Workflow').isExecuted) {\n    // Если запустили из Гейткипера\n    data = $('When Executed by Another Workflow').first().json || {};\n}\n\n// Отдаем унифицированные данные дальше\nreturn { json: data };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1936,
        192
      ],
      "id": "b903f8ff-9e12-482a-a8cc-86ddc7e73937",
      "name": "Normalize Input"
    },
    {
      "parameters": {
        "jsCode": "// Берем данные из нормализатора\nconst payload = $('Normalize Input').first().json.document_payload || {};\n\n// ГЕНЕРИРУЕМ ТЕКУЩУЮ ДАТУ В ФОРМАТЕ ДД.ММ.ГГГГ\nconst today = new Date().toLocaleDateString('ru-RU');\n\n// Безопасно формируем теги для Google Docs\nconst wrap = (val) => \"{{\" + val + \"}}\";\n\n// Собираем массив замен (добавили замену для {{date}})\nconst requests = [\n  { replaceAllText: { containsText: { text: wrap(\"date\"), matchCase: true }, replaceText: today } },\n  { replaceAllText: { containsText: { text: wrap(\"fio\"), matchCase: true }, replaceText: payload.fio || \"\" } },\n  { replaceAllText: { containsText: { text: wrap(\"position\"), matchCase: true }, replaceText: payload.position || \"\" } },\n  { replaceAllText: { containsText: { text: wrap(\"company\"), matchCase: true }, replaceText: payload.company || \"\" } },\n  { replaceAllText: { containsText: { text: wrap(\"inn\"), matchCase: true }, replaceText: payload.inn || \"\" } },\n  { replaceAllText: { containsText: { text: wrap(\"project_goals\"), matchCase: true }, replaceText: payload.project_goals || \"\" } },\n  { replaceAllText: { containsText: { text: wrap(\"proposed_solution\"), matchCase: true }, replaceText: payload.proposed_solution || \"\" } },\n  { replaceAllText: { containsText: { text: wrap(\"timeline_and_budget\"), matchCase: true }, replaceText: payload.timeline_and_budget || \"\" } }\n];\n\n// Отдаем готовый объект\nreturn {\n  json: {\n    google_docs_body: { \n      requests: requests \n    }\n  }\n};"
      },
