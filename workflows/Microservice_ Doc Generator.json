    {
      "parameters": {
        "jsCode": "// 1. Асинхронно читаем реальный физический файл с жесткого диска n8n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\n// 2. Превращаем его в чистую Base64-строку (как того требует API)\nconst base64Data = buffer.toString('base64');\n\n// 3. Берем имя компании для названия файла\nconst payload = $('Normalize Input').first().json.document_payload || {};\nconst companyName = payload.company || \"Client\";\n\n// 4. Отдаем чистую текстовую строку в следующий узел\nreturn {\n  json: {\n    ...$input.item.json,\n    pdf_base64: base64Data, // Кладем наш готовый файл сюда\n    company_name: companyName\n  }\n};"
      },
