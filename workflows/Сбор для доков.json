        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"inputs\": {\n    \"client_status\": \"onboarding_start\",\n    \"sales_context\": \"Ниша клиента: {{ $json.company_niche }}\\nИзначальная проблема: {{ $json.ai_pain_point }}\\nПредложенное решение: {{ $json.custom_pitch }}\\nБриф проекта (бюджет и сроки): {{ $json.project_brief }}\"\n  },\n  \"query\": \"СИСТЕМНОЕ СООБЩЕНИЕ: Опираясь строго на переданный sales_context, инициируй диалог. Подготовь приветственное сообщение, профессионально распиши детали проекта (бюджет, сроки, задачи) и обязательно запроси 4 реквизита для формирования договора (ФИО подписанта, должность, название компании, ИНН). Запрещено выдумывать любые данные, имена или цены, которых нет в контексте.\",\n  \"response_mode\": \"blocking\",\n  \"user\": \"{{ $json.contact_id }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
