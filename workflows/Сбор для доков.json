    {
      "parameters": {
        "jsCode": "const rawAnswer = $input.item.json.answer;\nconst conversationId = $input.item.json.conversation_id;\n\n// 1. Вырезаем монолог <think>\nlet cleanText = rawAnswer.replace(/<think>[\\s\\S]*?<\\/think>\\n*/g, '').trim();\n\n// 2. Убираем markdown (на случай, если ИИ его добавит)\ncleanText = cleanText.replace(/```json/g, '').replace(/```/g, '').trim();\n\n// 3. Парсим JSON\nlet parsedData = {};\ntry {\n  parsedData = JSON.parse(cleanText);\n} catch (e) {\n  // Запасной план: если ИИ почему-то выдал просто текст\n  parsedData = { reply_to_client: cleanText };\n}\n\n// 4. Достаем нужный текст (ИИ может выдать 'reply_to_client' или 'replytoclient')\nconst finalText = parsedData.reply_to_client || parsedData.replytoclient || parsedData.message || cleanText;\n\nreturn {\n  json: {\n    message_to_send: finalText,\n    conversation_id: conversationId\n  }\n};"
      },
