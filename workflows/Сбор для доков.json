    {
      "parameters": {
        "jsCode": "// 1. Проверяем, в каком формате пришли данные от Kommo, и парсим их при необходимости\nlet notesData;\nif (typeof $input.item.json.data === 'string') {\n  notesData = JSON.parse($input.item.json.data);\n} else {\n  notesData = $input.item.json;\n}\n\n// 2. Достаем crm_deal_id прямо из ссылки, которую возвращает сам Kommo\n// Это самый надежный способ, не зависящий от других узлов\nconst urlMatch = notesData._links.self.href.match(/leads\\/(\\d+)/);\nconst crmDealId = urlMatch ? urlMatch[1] : null;\n\n// 3. Вытягиваем самую последнюю заметку\nlet latestNoteText = \"Заметок нет\";\nif (notesData._embedded && notesData._embedded.notes && notesData._embedded.notes.length > 0) {\n  const notesArray = notesData._embedded.notes;\n  // Берем последний элемент массива\n  latestNoteText = notesArray[notesArray.length - 1].params.text; \n}\n\n// 4. Отдаем готовый пакет данных\nreturn {\n  crm_deal_id: crmDealId,\n  target_note: latestNoteText\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
